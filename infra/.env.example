# Local development only. Copy to .env and replace values if the environment is shared.
BUSINESS_POSTGRES_USER=symptom_app
BUSINESS_POSTGRES_PASSWORD=symptom_dev_only
BUSINESS_POSTGRES_PORT=5432

# Java payment-service settings (export in its terminal; Compose does not start Java).
# Both an explicit dev profile and this switch are required for simulated payment.
PAYMENT_MOCK_ENABLED=true

AI_POSTGRES_USER=symptom_ai
AI_POSTGRES_PASSWORD=symptom_ai_dev_only
AI_POSTGRES_PORT=5433

MINIO_ROOT_USER=symptom_minio
MINIO_ROOT_PASSWORD=symptom_minio_dev_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Used by image-service. The endpoint embedded in signed URLs must be reachable
# by the frontend; do not use the Compose-only hostname `minio` here.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=symptom_minio
MINIO_SECRET_KEY=symptom_minio_dev_only
MINIO_REGION=us-east-1
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=600

RABBITMQ_DEFAULT_USER=symptom_app
RABBITMQ_DEFAULT_PASS=symptom_rabbit_dev_only
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Matches the Spring Cloud Alibaba 2025.1.0.0 component matrix.
NACOS_VERSION=v3.1.1
NACOS_CONSOLE_PORT=18080
NACOS_SERVER_PORT=8848
# Keep this exactly 1000 above NACOS_SERVER_PORT for host-side Nacos clients.
NACOS_GRPC_PORT=9848
# Client API auth is temporarily off for the learning phase; Console/Admin auth stays on.
NACOS_AUTH_ENABLE=false
# Development-only values. Replace all three before sharing or exposing the environment.
NACOS_AUTH_TOKEN=VGhpc0lzTXlTdWZmaWNpZW50bHlMb25nRGV2U2VjcmV0S2V5MTIzNDU2Nzg5MA==
NACOS_AUTH_IDENTITY_KEY=symptom-dev-identity-key
NACOS_AUTH_IDENTITY_VALUE=symptom-dev-identity-value
NACOS_JVM_XMS=512m
NACOS_JVM_XMX=512m
NACOS_JVM_XMN=256m

SENTINEL_VERSION=1.8.9
SENTINEL_DASHBOARD_PORT=8858
SENTINEL_DASHBOARD_USERNAME=sentinel
SENTINEL_DASHBOARD_PASSWORD=sentinel_dev_only

# Export these in the Java process terminal when overriding Nacos development seeds.
GATEWAY_SENTINEL_ENABLED=true
GATEWAY_AGENT_ADVANCE_QPS=2
GATEWAY_IMAGE_UPLOAD_QPS=5
SENTINEL_DASHBOARD=127.0.0.1:8858
SENTINEL_TRANSPORT_PORT=8719
SENTINEL_CLIENT_IP=host.docker.internal
AI_PAYMENT_BREAKER_ENABLED=true

API_DOCS_PORT=18081

# Optional trace UI in this same Compose project: --profile observability.
JAEGER_VERSION=2.22.0
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

# Host-side ai-service only: export these in the Java terminal when needed.
# Merely copying this file to infra/.env does not configure a host Java process.
AI_MANAGEMENT_PORT=18085
AI_OTLP_ENABLED=false
AI_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
AI_TRACE_SAMPLING_PROBABILITY=1.0
